APP_NAME="FORGE API"
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://forge:forge@localhost:5432/forge
REDIS_URL=redis://localhost:6379/0

# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:3000"]

# OAuth — leave blank in dev; /auth/oauth/{provider}/authorize returns 501
# until these are set and the exchange is implemented in app/auth/router.py.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Mentor — leave blank to have /ai-mentor/chat return a clear 501 instead
# of a fake response. Get a key at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Leave false until the real sandboxed execution worker (plan §7) exists.
SANDBOX_ENABLED=false
